---
const { title = 'Adrian — ML/AI Engineer', description = 'Adrian is an ML/AI Engineer building practical machine learning systems, data projects, and technical experiments.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b0d0c" />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <div class="noise"></div>
  <header>
    <a class="brand" href="/">adrxor<span>_</span></a>
    <nav>
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/research">Research</a>
      <a href="/blog">Blog</a>
      <a href="/podcast">Podcast</a>
      <a href="/contact">Contact</a>
    </nav>
    <a class="status" href="/contact"><i></i> available to connect</a>
  </header>
  <main><slot /></main>
  <footer>
    <span>© {new Date().getFullYear()} Adrian</span>
    <span>ML/AI Engineer · build · experiment · measure · ship</span>
  </footer>
</body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#f2f3ed;background:#0b0d0c;--muted:#8e958d;--line:#252a27;--lime:#d7ff3f;--card:#111412}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% 5%,rgba(215,255,63,.07),transparent 30rem),#0b0d0c}body,.noise{overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}header{min-height:76px;max-width:1180px;margin:auto;padding:0 28px;display:flex;align-items:center;gap:28px;border-bottom:1px solid var(--line)}.brand{font:600 18px 'JetBrains Mono';color:#fff;text-decoration:none;letter-spacing:-1px;flex-shrink:0}.brand span{color:var(--lime)}nav{display:flex;gap:20px;margin-left:8px;flex-wrap:wrap}nav a,footer{color:var(--muted);font-size:13px;text-decoration:none}nav a:hover{color:#fff}.status{margin-left:auto;font:400 11px 'JetBrains Mono';color:var(--muted);text-decoration:none;white-space:nowrap}.status i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 12px var(--lime);margin-right:7px}main{max-width:1180px;margin:auto;padding:0 28px}footer{max-width:1180px;margin:90px auto 0;padding:22px 28px 35px;border-top:1px solid var(--line);display:flex;justify-content:space-between;font:12px 'JetBrains Mono'}h1,h2,h3,p{margin-top:0}.eyebrow{font:500 12px 'JetBrains Mono';color:var(--lime);text-transform:uppercase;letter-spacing:.14em}.grid{background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,#000,transparent 85%);position:absolute;inset:0;opacity:.25;pointer-events:none}@media(max-width:900px){.status{display:none}}@media(max-width:700px){header{padding:12px 18px;min-height:68px;align-items:flex-start}.brand{padding-top:5px}nav{gap:10px;margin-left:auto;justify-content:flex-end}nav a{font-size:11px}main{padding:0 18px}footer{margin-top:60px;padding-left:18px;padding-right:18px;flex-direction:column;gap:8px}}
</style>
