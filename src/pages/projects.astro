---
import Layout from '../layouts/Layout.astro';
const projects=[{tag:'01 · MACHINE LEARNING',title:'California House Price Prediction',text:'End-to-end regression project covering data cleaning, feature engineering, model comparison, evaluation, and a reproducible workflow.',href:'https://github.com/adrxor/house-price-prediction'}];
---
<Layout title="Projects — Adrian" description="Selected ML/AI and engineering projects by Adrian."><section class="page"><div class="eyebrow">/ selected work</div><h1>Things I've<br/><em>built.</em></h1><div class="projects">{projects.map(p=><article><span>{p.tag}</span><h2>{p.title}</h2><p>{p.text}</p><a href={p.href} target="_blank" rel="noreferrer">Open on GitHub ↗</a></article>)}</div></section></Layout>
<style>.page{padding:110px 0}.page>h1{font-size:clamp(58px,8vw,100px);line-height:.9;letter-spacing:-.065em;margin:20px 0 80px}.page h1 em{font-style:normal;color:var(--lime)}.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.projects article{min-height:350px;border:1px solid var(--line);padding:32px;display:flex;flex-direction:column;background:linear-gradient(145deg,#121613,#0d100f);transition:transform .2s,border-color .2s}.projects article:hover{transform:translateY(-4px);border-color:#414940}.projects span{font:10px 'JetBrains Mono';color:var(--lime)}.projects h2{font-size:32px;line-height:1.05;letter-spacing:-.04em;margin:55px 0 15px}.projects p{color:#959c94;line-height:1.7;max-width:500px}.projects a{margin-top:auto;color:#fff;text-decoration:none;font:500 12px 'JetBrains Mono'}.projects a:hover{color:var(--lime)}@media(max-width:750px){.page{padding:80px 0}.projects{grid-template-columns:1fr}}
</style>
