---
import Layout from '../layouts/Layout.astro'; import { getCollection } from 'astro:content';
const projects=(await getCollection('projects')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured));
---
<Layout title="Projects — Adrian"><section class="page"><div class="eyebrow">/ selected work</div><div class="heading"><h1>Things I've<br/><em>built.</em></h1><p>A small collection of projects where data, models, and engineering meet.</p></div><div class="projects">{projects.map((p,i)=><article class="project"><div class="num">0{i+1}</div><div class="tag">{p.data.featured?'FEATURED PROJECT':'PROJECT'}</div><h2>{p.data.title}</h2><p>{p.data.description}</p><a href={p.data.github} target="_blank" rel="noreferrer">Open repository <span>↗</span></a></article>)}</div></section></Layout>
<style>.heading{display:flex;align-items:end;justify-content:space-between;gap:50px;border-bottom:1px solid var(--line);padding-bottom:45px}.heading p{max-width:380px;margin:0}.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:28px}.project{position:relative;background:#fffdf8;border:1px solid var(--line);border-radius:20px;padding:32px;min-height:350px;display:flex;flex-direction:column;overflow:hidden;transition:.25s}.project:hover{transform:translateY(-5px);box-shadow:0 20px 50px #17171712}.project:after{content:'';position:absolute;width:170px;height:170px;border-radius:50%;background:#3157ff10;right:-65px;top:-65px}.num{font:600 11px var(--mono);color:#aaa49b}.tag{font:10px var(--mono);color:var(--blue);margin-top:45px}.project h2{font-size:34px;line-height:1;letter-spacing:-.045em;max-width:500px;margin:13px 0}.project p{max-width:560px}.project a{margin-top:auto;color:var(--ink);text-decoration:none;font:600 11px var(--mono)}.project a span{color:var(--blue);margin-left:8px}@media(max-width:700px){.heading{display:block}.projects{grid-template-columns:1fr}.project{min-height:300px}}
</style>
