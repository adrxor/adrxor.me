---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Admin — Adrian" description="Private content management panel.">
<section class="admin">
  <div class="eyebrow">/ private control room</div>
  <div class="head"><div><h1>Content <em>control.</em></h1><p>A real content dashboard for research, writing, and publishing. Create, edit, preview, publish, unpublish, and delete posts without touching the database.</p></div><a href="/">← public site</a></div>

  <div class="auth card">
    <div><span class="label">ACCESS</span><h2>Admin session</h2><p>Credentials are sent to the Worker over HTTPS. The temporary Basic Auth token stays only in this browser session.</p></div>
    <div class="authgrid"><input id="user" placeholder="username" autocomplete="username"><input id="pass" type="password" placeholder="password" autocomplete="current-password"><button id="saveAuth">Unlock</button><button id="logout" class="danger ghost">Lock</button></div>
    <div id="authStatus" class="statusline">Locked.</div>
  </div>

  <div class="tabs"><button class="tab active" data-tab="blog">Blog</button><button class="tab" data-tab="research">Research</button><button class="tab" data-tab="podcast">Podcast</button></div>

  <section id="blog" class="panel active">
    <div class="workspace">
      <div class="card editor-card">
        <div class="section-top"><div><span class="label">01 · EDITOR</span><h2 id="editorTitle">Write a field note</h2></div><span id="editBadge" class="badge">NEW</span></div>
        <form id="blogForm">
          <input type="hidden" name="id"><input name="title" required placeholder="Post title"><input name="slug" placeholder="slug (optional)">
          <input name="excerpt" placeholder="One-line excerpt"><input name="tags" placeholder="ml, ai, python">
          <textarea name="content" rows="18" required placeholder="Write your post here…"></textarea>
          <div class="form-row"><label class="check"><input name="published" type="checkbox"> <span>Published</span></label><div class="actions"><button type="button" id="previewPost" class="ghost">Preview</button><button type="button" id="newPost" class="ghost">New</button><button type="submit" id="savePost">Save post ↗</button></div></div>
        </form><div id="blogMsg" class="msg"></div>
      </div>
      <div class="card list-card">
        <div class="section-top"><div><span class="label">02 · CONTENT</span><h2>Posts</h2></div><button id="refreshPosts" class="ghost">Refresh</button></div>
        <div class="stats"><div><b id="totalCount">0</b><small>TOTAL</small></div><div><b id="liveCount">0</b><small>LIVE</small></div><div><b id="draftCount">0</b><small>DRAFTS</small></div></div>
        <div class="toolbar"><input id="postSearch" placeholder="Search posts…"><select id="postFilter"><option value="all">All</option><option value="published">Published</option><option value="draft">Drafts</option></select></div>
        <div id="postList" class="post-list"><div class="empty">Unlock the panel first.</div></div>
      </div>
    </div>
  </section>

  <section id="research" class="panel">
    <div class="card">
      <div class="section-top"><div><span class="label">03 · RESEARCH</span><h2>Add a research item</h2></div></div>
      <p class="hint">R2 is intentionally not required. Put the PDF in GitHub Pages (for example <code>/research/paper.pdf</code>) or any public HTTPS host, then save its URL here.</p>
      <form id="researchForm"><input name="title" required placeholder="Research title"><input name="slug" placeholder="slug (optional)"><textarea name="description" rows="4" placeholder="Short description"></textarea><input name="tags" placeholder="tags, separated by commas"><input name="file_url" type="url" required placeholder="https://adrxor.me/research/paper.pdf"><input name="file_name" placeholder="paper.pdf"><button type="submit">Add to research library ↗</button></form><div id="researchMsg" class="msg"></div>
    </div>
    <div class="card"><div class="section-top"><div><span class="label">04 · LIBRARY</span><h2>Research</h2></div><button id="refreshResearch" class="ghost">Refresh</button></div><div id="researchList" class="content-list"></div></div>
  </section>

  <section id="podcast" class="panel">
    <div class="card">
      <div class="section-top"><div><span class="label">05 · PODCAST</span><h2>Add an episode</h2></div></div>
      <p class="hint">Same idea as research: host the audio file on a public HTTPS URL, then register the episode here. This keeps the Worker free of paid storage dependencies.</p>
      <form id="podcastForm"><input name="title" required placeholder="Episode title"><input name="episode" placeholder="Episode number"><input name="description" placeholder="Short description"><input name="file_url" type="url" required placeholder="https://…/episode.mp3"><input name="file_name" placeholder="episode.mp3"><button type="submit">Add episode ↗</button></form><div id="podcastMsg" class="msg"></div>
    </div>
  </section>
</section>
</Layout>
<script>
const state={auth:sessionStorage.getItem('adrxor_admin_auth')||'',api:'https://api.adrxor.me',posts:[],editing:null};
const $=s=>document.querySelector(s); const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function msg(el,text,ok=false){el.textContent=text;el.className='msg '+(ok?'ok':'err')}
async function api(path,opt={}){opt.headers={...(opt.headers||{}),...(state.auth?{Authorization:'Basic '+state.auth}:{})};const r=await fetch(state.api+path,opt);let data=null;try{data=await r.json()}catch{}if(!r.ok)throw new Error(data?.error||`Request failed (${r.status})`);return data}
function formData(){const f=new FormData($('#blogForm'));return{title:f.get('title'),slug:f.get('slug'),excerpt:f.get('excerpt'),tags:String(f.get('tags')||'').split(',').map(x=>x.trim()).filter(Boolean),content:f.get('content'),published:f.get('published')==='on'}}
function resetEditor(){state.editing=null;$('#blogForm').reset();$('#blogForm [name=id]').value='';$('#editorTitle').textContent='Write a field note';$('#editBadge').textContent='NEW';$('#savePost').textContent='Save post ↗'}
function renderPosts(){const q=$('#postSearch').value.toLowerCase().trim(),f=$('#postFilter').value;const all=state.posts;$('#totalCount').textContent=all.length;$('#liveCount').textContent=all.filter(x=>x.published).length;$('#draftCount').textContent=all.filter(x=>!x.published).length;const items=all.filter(x=>(f==='all'||(f==='published'?x.published:!x.published))&&(!q||`${x.title} ${x.excerpt} ${(x.tags||[]).join(' ')}`.toLowerCase().includes(q)));$('#postList').innerHTML=items.length?items.map(x=>`<article class="post-row"><div class="post-main"><div class="post-meta"><span class="badge ${x.published?'live':'draft'}">${x.published?'LIVE':'DRAFT'}</span><time>${esc(new Date(x.published_at||x.created_at).toLocaleDateString())}</time></div><h3>${esc(x.title)}</h3><p>${esc(x.excerpt||'No excerpt yet.')}</p><div class="tags">${(x.tags||[]).map(t=>`<span>#${esc(t)}</span>`).join('')}</div></div><div class="post-actions"><button data-edit="${x.id}" class="ghost">Edit</button><a href="/blog/?slug=${encodeURIComponent(x.slug)}" target="_blank" class="ghost">View</a><button data-delete="${x.id}" class="danger ghost">Delete</button></div></article>`).join(''):'<div class="empty">No posts match your filter.</div>';document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editPost(Number(b.dataset.edit)));document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>deletePost(Number(b.dataset.delete)))}
async function loadPosts(){try{const d=await api('/api/posts/all');state.posts=d.items||[];renderPosts()}catch(e){$('#postList').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
function editPost(id){const x=state.posts.find(p=>p.id===id);if(!x)return;state.editing=id;const f=$('#blogForm');f.title.value=x.title;f.slug.value=x.slug;f.excerpt.value=x.excerpt||'';f.tags.value=(x.tags||[]).join(', ');f.content.value=x.content;f.published.checked=x.published;f.id.value=x.id;$('#editorTitle').textContent='Edit field note';$('#editBadge').textContent='EDITING';$('#savePost').textContent='Update post ↗';window.scrollTo({top:document.querySelector('.editor-card').offsetTop-30,behavior:'smooth'})}
async function deletePost(id){const x=state.posts.find(p=>p.id===id);if(!x||!confirm(`Delete “${x.title}”? This cannot be undone.`))return;try{await api('/api/posts/'+id,{method:'DELETE'});if(state.editing===id)resetEditor();await loadPosts()}catch(e){msg($('#blogMsg'),e.message)}}
$('#saveAuth').onclick=async()=>{const u=$('#user').value.trim(),p=$('#pass').value;if(!u||!p)return;state.auth=btoa(`${u}:${p}`);try{await api('/api/auth/check');sessionStorage.setItem('adrxor_admin_auth',state.auth);$('#authStatus').textContent='Unlocked · authenticated';$('#authStatus').className='statusline ok';loadPosts();loadResearch()}catch(e){state.auth='';$('#authStatus').textContent='Could not unlock. Check credentials.';$('#authStatus').className='statusline err'}};
$('#logout').onclick=()=>{state.auth='';sessionStorage.removeItem('adrxor_admin_auth');$('#authStatus').textContent='Locked.';$('#authStatus').className='statusline';state.posts=[];renderPosts()};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('#'+b.dataset.tab).classList.add('active')});
$('#blogForm').onsubmit=async e=>{e.preventDefault();try{msg($('#blogMsg'),state.editing?'Saving…':'Publishing…');const id=state.editing;await api(id?'/api/posts/'+id:'/api/posts',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(formData())});msg($('#blogMsg'),id?'Post updated.':'Post created.',true);resetEditor();await loadPosts()}catch(x){msg($('#blogMsg'),x.message)}};
$('#newPost').onclick=resetEditor;$('#refreshPosts').onclick=loadPosts;$('#postSearch').oninput=renderPosts;$('#postFilter').onchange=renderPosts;
$('#previewPost').onclick=()=>{const f=formData();const w=window.open('/blog/?preview=1','_blank');if(w)sessionStorage.setItem('adrxor_preview',JSON.stringify(f))};
async function loadResearch(){try{const d=await api('/api/research');$('#researchList').innerHTML=d.items?.length?d.items.map(x=>`<article class="content-row"><div><span class="badge live">RESEARCH</span><h3>${esc(x.title)}</h3><p>${esc(x.description||'')}</p><small>${esc(new Date(x.created_at).toLocaleDateString())} · ${(x.tags||[]).map(esc).join(', ')}</small></div><a href="${esc(x.file_url)}" target="_blank" class="ghost">Open PDF ↗</a></article>`).join(''):'<div class="empty">No research yet.</div>'}catch(e){$('#researchList').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
$('#researchForm').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget);const b=Object.fromEntries(f.entries());b.tags=String(b.tags||'').split(',').map(x=>x.trim()).filter(Boolean);try{msg($('#researchMsg'),'Saving…');await api('/api/research',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});e.currentTarget.reset();msg($('#researchMsg'),'Research item added.',true);loadResearch()}catch(x){msg($('#researchMsg'),x.message)}};$('#refreshResearch').onclick=loadResearch;
$('#podcastForm').onsubmit=async e=>{e.preventDefault();const b=Object.fromEntries(new FormData(e.currentTarget).entries());try{msg($('#podcastMsg'),'Saving…');await api('/api/podcast',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});e.currentTarget.reset();msg($('#podcastMsg'),'Episode added.',true)}catch(x){msg($('#podcastMsg'),x.message)}};
if(state.auth){api('/api/auth/check').then(()=>{ $('#authStatus').textContent='Unlocked · saved session';$('#authStatus').className='statusline ok';loadPosts();loadResearch()}).catch(()=>{state.auth='';sessionStorage.removeItem('adrxor_admin_auth')})}
</script>
<style>
.admin{padding:90px 0 130px}.head{display:flex;justify-content:space-between;gap:40px;align-items:end;border-bottom:1px solid var(--line);padding-bottom:42px;margin-bottom:26px}.head h1{font-size:clamp(52px,8vw,94px);line-height:.9;letter-spacing:-.065em;margin:18px 0}.head em{font-style:normal;color:var(--lime)}.head p,.hint{color:#929a92;line-height:1.7;max-width:700px}.head a{color:var(--lime);font:12px 'JetBrains Mono';text-decoration:none;white-space:nowrap}.card{border:1px solid var(--line);background:linear-gradient(145deg,#121613,#0d100f);padding:28px;margin-bottom:18px}.label{font:10px 'JetBrains Mono';color:var(--lime);letter-spacing:.12em}.card h2{margin:10px 0 8px;font-size:28px;letter-spacing:-.04em}.authgrid{display:grid;grid-template-columns:1fr 1fr auto auto;gap:10px;margin-top:18px}.tabs{display:flex;gap:8px;margin:28px 0 18px}.tab,.ghost{border:1px solid var(--line);background:#101310;color:#aeb4ad;padding:11px 15px;font:11px 'JetBrains Mono';cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.tab.active,.tab:hover,.ghost:hover{color:#0b0d0c;background:var(--lime);border-color:var(--lime)}.danger{color:#ff8f8f}.danger:hover{background:#ff8f8f!important;border-color:#ff8f8f!important}.panel{display:none}.panel.active{display:block}.workspace{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:18px}.section-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.editor-card{position:sticky;top:20px;align-self:start}.badge{display:inline-flex;border:1px solid #394039;padding:5px 7px;font:9px 'JetBrains Mono';letter-spacing:.08em;color:#9da59d}.badge.live{color:var(--lime);border-color:#475338}.badge.draft{color:#a4aaa3}.form-row{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:4px}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions button[type=submit],form>button[type=submit]{border:0;background:var(--lime);color:#0b0d0c;padding:12px 16px;font:600 11px 'JetBrains Mono';cursor:pointer}.check{color:#929a92;font-size:13px}.check input{width:auto;margin-right:7px}.toolbar{display:grid;grid-template-columns:1fr 120px;gap:8px;margin:20px 0 12px}input,textarea,select{width:100%;border:1px solid var(--line);background:#0a0d0b;color:#f2f3ed;padding:13px 14px;font:14px 'DM Sans';outline:none}textarea{resize:vertical;line-height:1.65}select{appearance:none}.toolbar input{font:12px 'JetBrains Mono'}input:focus,textarea:focus,select:focus{border-color:#65705f}.form-row+.msg{margin-top:10px}.msg,.statusline{font:11px 'JetBrains Mono';margin-top:12px;color:#929a92}.ok{color:var(--lime)}.err{color:#ff8f8f}.stats{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin-top:18px}.stats div{padding:13px 14px;border-right:1px solid var(--line)}.stats div:last-child{border-right:0}.stats b{display:block;font-size:22px}.stats small{font:9px 'JetBrains Mono';color:#737b73}.post-list{border-top:1px solid var(--line)}.post-row{padding:18px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:16px}.post-main{min-width:0}.post-meta{display:flex;align-items:center;gap:8px}.post-meta time,.post-main p,.content-row p,.content-row small{color:#7f877f;font-size:11px;line-height:1.55}.post-main h3{font-size:19px;margin:9px 0 5px;letter-spacing:-.02em}.post-main p{margin:0 0 8px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tags span{font:9px 'JetBrains Mono';color:#6f776f}.post-actions{display:flex;gap:6px;flex-wrap:wrap;align-content:flex-start;justify-content:flex-end}.empty{padding:24px 0;color:#777f77;font:11px 'JetBrains Mono'}.content-list{margin-top:20px;border-top:1px solid var(--line)}.content-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px 0;border-bottom:1px solid var(--line)}.content-row h3{margin:8px 0 4px}.content-row p{margin:0 0 5px}.hint code{font:11px 'JetBrains Mono';color:var(--lime)}@media(max-width:900px){.workspace{grid-template-columns:1fr}.editor-card{position:static}.head{display:block}.head a{display:inline-block;margin-top:20px}.authgrid{grid-template-columns:1fr 1fr}.post-row,.content-row{display:block}.post-actions{justify-content:flex-start;margin-top:12px}}@media(max-width:650px){.admin{padding:65px 0}.authgrid,.toolbar{grid-template-columns:1fr}.form-row{display:block}.actions{margin-top:14px}.tabs{overflow:auto}.tab{white-space:nowrap}.stats b{font-size:18px}}
</style>
