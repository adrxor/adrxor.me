---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const research = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const initialPosts = posts.map((post) => ({
  id: post.id,
  path: `src/content/blog/${post.id}`,
  title: post.data.title,
  slug: post.data.slug || post.id.replace(/\.(md|mdx)$/i, ''),
  excerpt: post.data.excerpt || '',
  description: post.data.description || '',
  tags: post.data.tags || [],
  content: post.body || '',
  published: post.data.published,
  date: post.data.date.toISOString(),
}));
const initialProjects = projects.map((item) => ({
  id: item.id, title: item.data.title, description: item.data.description || '', github: item.data.github, featured: item.data.featured, content: item.body || ''
}));
const initialResearch = research.map((item) => ({
  id: item.id, title: item.data.title, description: item.data.description || '', tags: item.data.tags || [],
  pdf: item.data.pdf || '', date: item.data.date.toISOString(), content: item.body || ''
}));
---
<Layout title="Admin — Adrian" description="Private GitHub-backed content management panel.">
<section class="admin">
  <div class="eyebrow">/ private control room</div>
  <div class="head">
    <div><h1>Content <em>control.</em></h1><p>Manage blog posts directly in GitHub. No database, Worker, or storage service is required.</p></div>
    <a href="/">← public site</a>
  </div>

  <div class="auth card">
    <div><span class="label">GITHUB ACCESS</span><h2>Admin session</h2><p>Use a GitHub fine-grained token with access only to <code>adrxor/adrxor.me</code> and repository <strong>Contents: Read and write</strong>. The token is kept in this browser session and sent only to GitHub's API.</p></div>
    <div class="authgrid">
      <input id="token" type="password" placeholder="github_pat_…" autocomplete="off">
      <button id="saveAuth">Connect GitHub</button>
      <button id="logout" class="danger ghost">Lock</button>
    </div>
    <div id="authStatus" class="statusline">Locked.</div>
  </div>

  <div class="tabs"><button class="tab active" data-tab="blog">Blog</button><button class="tab" data-tab="research">Research</button><button class="tab" data-tab="projects">Projects</button></div>

  <section id="blog" class="panel active">
    <div class="workspace">
      <div class="card editor-card">
        <div class="section-top"><div><span class="label">01 · EDITOR</span><h2 id="editorTitle">Write a field note</h2></div><span id="editBadge" class="badge">NEW</span></div>
        <form id="blogForm">
          <input type="hidden" name="id"><input name="title" required placeholder="Post title"><input name="slug" placeholder="slug (optional)">
          <input name="excerpt" placeholder="One-line excerpt"><input name="tags" placeholder="ml, ai, python">
          <textarea name="content" rows="18" required placeholder="Write your post here… Markdown is supported."></textarea>
          <div class="form-row"><label class="check"><input name="published" type="checkbox"> <span>Published</span></label><div class="actions"><button type="button" id="previewPost" class="ghost">Preview</button><button type="button" id="newPost" class="ghost">New</button><button type="submit" id="savePost">Commit to GitHub ↗</button></div></div>
        </form><div id="blogMsg" class="msg"></div>
      </div>
      <div class="card list-card">
        <div class="section-top"><div><span class="label">02 · CONTENT</span><h2>Posts</h2></div><button id="refreshPosts" class="ghost">Refresh</button></div>
        <div class="stats"><div><b id="totalCount">0</b><small>TOTAL</small></div><div><b id="liveCount">0</b><small>LIVE</small></div><div><b id="draftCount">0</b><small>DRAFTS</small></div></div>
        <div class="toolbar"><input id="postSearch" placeholder="Search posts…"><select id="postFilter"><option value="all">All</option><option value="published">Published</option><option value="draft">Drafts</option></select></div>
        <div id="postList" class="post-list"></div>
      </div>
    </div>
  </section>

  <section id="research" class="panel">
    <div class="workspace">
      <div class="card editor-card"><span class="label">03 · EDITOR</span><h2 id="researchTitle">Add research</h2><span id="researchBadge" class="badge">NEW</span>
        <form id="researchForm"><input type="hidden" name="id"><input name="title" required placeholder="Research title"><input name="description" placeholder="Short description"><input name="tags" placeholder="Transformers, Deep Learning"><input name="pdf" placeholder="/research/file.pdf"><textarea name="content" rows="10" placeholder="Optional Markdown notes…"></textarea><div class="actions"><button type="button" id="newResearch" class="ghost">New</button><button type="submit">Commit to GitHub ↗</button></div></form><div id="researchMsg" class="msg"></div></div>
      <div class="card"><div class="section-top"><div><span class="label">04 · CONTENT</span><h2>Research</h2></div><a class="ghost" href="https://github.com/adrxor/adrxor.me/tree/main/public/research" target="_blank" rel="noreferrer">PDF files ↗</a></div><div id="researchList" class="post-list"></div></div>
    </div>
  </section>

  <section id="projects" class="panel">
    <div class="workspace">
      <div class="card editor-card">
        <div class="section-top"><div><span class="label">05 · EDITOR</span><h2 id="projectTitle">Add project</h2></div><span id="projectBadge" class="badge">NEW</span></div>
        <form id="projectForm">
          <input type="hidden" name="id">
          <input name="title" required placeholder="Project title">
          <input name="description" placeholder="Very short project description">
          <input name="github" type="url" required placeholder="https://github.com/adrxor/project">
          <label class="check"><input name="featured" type="checkbox"> <span>Featured project</span></label>
          <div class="actions"><button type="button" id="newProject" class="ghost">New</button><button type="submit">Commit to GitHub ↗</button></div>
        </form><div id="projectMsg" class="msg"></div>
      </div>
      <div class="card"><div class="section-top"><div><span class="label">06 · CONTENT</span><h2>Projects</h2></div><a class="ghost" href="https://github.com/adrxor/adrxor.me/tree/main/src/content/projects" target="_blank" rel="noreferrer">Open content ↗</a></div><div id="projectList" class="post-list"></div></div>
    </div>
  </section>
</section>
</Layout>
<script define:vars={{ initialPosts, initialResearch, initialProjects }}>
const REPO='adrxor/adrxor.me';
const API='https://api.github.com';
const state={token:sessionStorage.getItem('adrxor_github_token')||'',posts:initialPosts,research:initialResearch,projects:initialProjects,editing:null,researchEditing:null,projectEditing:null};
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function msg(el,text,ok=false){el.textContent=text;el.className='msg '+(ok?'ok':'err')}
function headers(){return{Accept:'application/vnd.github+json',Authorization:`Bearer ${state.token}`,'X-GitHub-Api-Version':'2022-11-28'}}
async function gh(path,opt={}){const r=await fetch(API+path,{...opt,headers:{...headers(),...(opt.headers||{})}});let data=null;try{data=await r.json()}catch{}if(!r.ok)throw new Error(data?.message||`GitHub request failed (${r.status})`);return data}
function base64(s){const bytes=new TextEncoder().encode(s);let binary='';bytes.forEach(b=>binary+=String.fromCharCode(b));return btoa(binary)}
function formData(){const f=new FormData($('#blogForm'));return{title:String(f.get('title')||'').trim(),slug:String(f.get('slug')||'').trim(),excerpt:String(f.get('excerpt')||'').trim(),tags:String(f.get('tags')||'').split(',').map(x=>x.trim()).filter(Boolean),content:String(f.get('content')||''),published:f.get('published')==='on'}}
function slugify(s){return String(s).toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').slice(0,90)||`post-${Date.now()}`}
function yaml(data,date=new Date().toISOString()){const title=JSON.stringify(data.title),slug=JSON.stringify(data.slug),excerpt=JSON.stringify(data.excerpt||''),tags=JSON.stringify(data.tags||[]);return `---\ntitle: ${title}\nslug: ${slug}\ndescription: ${excerpt}\nexcerpt: ${excerpt}\ndate: ${date.slice(0,10)}\ntags: ${tags}\npublished: ${data.published?'true':'false'}\n---\n\n${data.content.trim()}\n`}
function resetEditor(){state.editing=null;$('#blogForm').reset();$('#blogForm [name=id]').value='';$('#editorTitle').textContent='Write a field note';$('#editBadge').textContent='NEW';$('#savePost').textContent='Commit to GitHub ↗'}
function renderPosts(){const q=$('#postSearch').value.toLowerCase().trim(),f=$('#postFilter').value,all=state.posts;$('#totalCount').textContent=all.length;$('#liveCount').textContent=all.filter(x=>x.published).length;$('#draftCount').textContent=all.filter(x=>!x.published).length;const items=all.filter(x=>(f==='all'||(f==='published'?x.published:!x.published))&&(!q||`${x.title} ${x.excerpt} ${(x.tags||[]).join(' ')}`.toLowerCase().includes(q)));$('#postList').innerHTML=items.length?items.map(x=>`<article class="post-row"><div class="post-main"><div class="post-meta"><span class="badge ${x.published?'live':'draft'}">${x.published?'LIVE':'DRAFT'}</span><time>${esc(new Date(x.date).toLocaleDateString())}</time></div><h3>${esc(x.title)}</h3><p>${esc(x.excerpt||'No excerpt yet.')}</p><div class="tags">${(x.tags||[]).map(t=>`<span>#${esc(t)}</span>`).join('')}</div></div><div class="post-actions"><button data-edit="${esc(x.id)}" class="ghost">Edit</button><a href="/blog/?slug=${encodeURIComponent(x.slug)}" class="ghost">View</a><button data-delete="${esc(x.id)}" class="danger ghost">Delete</button></div></article>`).join(''):'<div class="empty">No posts match your filter.</div>';document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editPost(b.dataset.edit));document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>deletePost(b.dataset.delete))}
function editPost(id){const x=state.posts.find(p=>p.id===id);if(!x)return;state.editing=id;const f=$('#blogForm');f.title.value=x.title;f.slug.value=x.slug;f.excerpt.value=x.excerpt||'';f.tags.value=(x.tags||[]).join(', ');f.content.value=x.content;f.published.checked=x.published;f.id.value=x.id;$('#editorTitle').textContent='Edit field note';$('#editBadge').textContent='EDITING';$('#savePost').textContent='Commit update ↗';window.scrollTo({top:document.querySelector('.editor-card').offsetTop-30,behavior:'smooth'})}
async function commitFile(path,content,message,sha){const body={message,content:base64(content),branch:'main'};if(sha)body.sha=sha;return gh(`/repos/${REPO}/contents/${path}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})}
async function savePost(data){const slug=slugify(data.slug||data.title);const newId=`${slug}.md`;const old=state.editing?state.posts.find(p=>p.id===state.editing):null;const content=yaml({...data,slug},old?.date||new Date().toISOString());if(old&&old.id!==newId){const oldFile=await gh(`/repos/${REPO}/contents/src/content/blog/${encodeURIComponent(old.id)}`);await gh(`/repos/${REPO}/contents/src/content/blog/${encodeURIComponent(old.id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Delete old blog path for ${slug}`,sha:oldFile.sha,branch:'main'})});await commitFile(`src/content/blog/${newId}`,content,`Update blog: ${data.title}`)}else{let sha=null;if(old){const oldFile=await gh(`/repos/${REPO}/contents/src/content/blog/${encodeURIComponent(old.id)}`);sha=oldFile.sha}await commitFile(`src/content/blog/${newId}`,content,`${old?'Update':'Add'} blog: ${data.title}`,sha)}}
async function deletePost(id){const x=state.posts.find(p=>p.id===id);if(!x||!confirm(`Delete “${x.title}” from GitHub? This cannot be undone.`))return;try{msg($('#blogMsg'),'Deleting from GitHub…');const file=await gh(`/repos/${REPO}/contents/src/content/blog/${encodeURIComponent(x.id)}`);await gh(`/repos/${REPO}/contents/src/content/blog/${encodeURIComponent(x.id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Delete blog: ${x.title}`,sha:file.sha,branch:'main'})});if(state.editing===id)resetEditor();msg($('#blogMsg'),'Deleted. GitHub Actions will rebuild the site.',true);state.posts=state.posts.filter(p=>p.id!==id);renderPosts()}catch(e){msg($('#blogMsg'),e.message)}}

function researchData(){const f=new FormData($('#researchForm'));return{title:String(f.get('title')||'').trim(),description:String(f.get('description')||'').trim(),tags:String(f.get('tags')||'').split(',').map(x=>x.trim()).filter(Boolean),pdf:String(f.get('pdf')||'').trim(),content:String(f.get('content')||'').trim()}}
function researchYaml(d,date=new Date().toISOString()){return `---\ntitle: ${JSON.stringify(d.title)}\ndescription: ${JSON.stringify(d.description)}\ndate: ${date.slice(0,10)}\ntags: ${JSON.stringify(d.tags)}\npdf: ${JSON.stringify(d.pdf)}\n---\n\n${d.content}\n`}
function resetResearch(){state.researchEditing=null;$('#researchForm').reset();$('#researchForm [name=id]').value='';$('#researchTitle').textContent='Add research';$('#researchBadge').textContent='NEW'}
function renderResearch(){const list=$('#researchList');list.innerHTML=state.research.length?state.research.map(x=>`<article class="post-row"><div class="post-main"><h3>${esc(x.title)}</h3><p>${esc(x.description||'No description yet.')}</p><div class="tags">${(x.tags||[]).map(t=>`<span>#${esc(t)}</span>`).join('')}</div></div><div class="post-actions"><button data-redit="${esc(x.id)}" class="ghost">Edit</button><button data-rdelete="${esc(x.id)}" class="danger ghost">Delete</button></div></article>`).join(''):'<div class="empty">No research items yet.</div>';document.querySelectorAll('[data-redit]').forEach(b=>b.onclick=()=>editResearch(b.dataset.redit));document.querySelectorAll('[data-rdelete]').forEach(b=>b.onclick=()=>deleteResearch(b.dataset.rdelete))}
function editResearch(id){const x=state.research.find(r=>r.id===id);if(!x)return;state.researchEditing=id;const f=$('#researchForm');f.title.value=x.title;f.description.value=x.description||'';f.tags.value=(x.tags||[]).join(', ');f.pdf.value=x.pdf||'';f.content.value=x.content||'';f.id.value=x.id;$('#researchTitle').textContent='Edit research';$('#researchBadge').textContent='EDITING'}
async function saveResearch(d){const id=(state.researchEditing||`${slugify(d.title)}.md`);const content=researchYaml(d,state.research.find(x=>x.id===state.researchEditing)?.date||new Date().toISOString());let sha=null;if(state.researchEditing){const file=await gh(`/repos/${REPO}/contents/src/content/research/${encodeURIComponent(id)}`);sha=file.sha}await commitFile(`src/content/research/${id}`,content,`${state.researchEditing?'Update':'Add'} research: ${d.title}`,sha)}
async function deleteResearch(id){const x=state.research.find(r=>r.id===id);if(!x||!confirm(`Delete “${x.title}” from GitHub?`))return;try{msg($('#researchMsg'),'Deleting from GitHub…');const file=await gh(`/repos/${REPO}/contents/src/content/research/${encodeURIComponent(id)}`);await gh(`/repos/${REPO}/contents/src/content/research/${encodeURIComponent(id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Delete research: ${x.title}`,sha:file.sha,branch:'main'})});state.research=state.research.filter(r=>r.id!==id);resetResearch();renderResearch();msg($('#researchMsg'),'Deleted. GitHub Actions will rebuild the site.',true)}catch(e){msg($('#researchMsg'),e.message)}}
$('#researchForm').onsubmit=async e=>{e.preventDefault();if(!state.token)return msg($('#researchMsg'),'Connect GitHub first.');const d=researchData();if(!d.title)return;try{msg($('#researchMsg'),state.researchEditing?'Committing update…':'Committing research…');await saveResearch(d);const id=state.researchEditing||`${slugify(d.title)}.md`;state.research=state.research.filter(x=>x.id!==id);state.research.unshift({id,title:d.title,description:d.description,tags:d.tags,pdf:d.pdf,content:d.content,date:new Date().toISOString()});resetResearch();renderResearch();msg($('#researchMsg'),'Committed to GitHub. GitHub Actions will rebuild the site shortly.',true)}catch(e){msg($('#researchMsg'),e.message)}};$('#newResearch').onclick=resetResearch;

function projectData(){const f=new FormData($('#projectForm'));return{title:String(f.get('title')||'').trim(),description:String(f.get('description')||'').trim(),github:String(f.get('github')||'').trim(),featured:f.get('featured')==='on'}}
function projectYaml(d){return `---\ntitle: ${JSON.stringify(d.title)}\ndescription: ${JSON.stringify(d.description)}\ngithub: ${JSON.stringify(d.github)}\nfeatured: ${d.featured?'true':'false'}\n---\n`}
function resetProject(){state.projectEditing=null;$('#projectForm').reset();$('#projectForm [name=id]').value='';$('#projectTitle').textContent='Add project';$('#projectBadge').textContent='NEW'}
function renderProjects(){const list=$('#projectList');list.innerHTML=state.projects.length?state.projects.map(x=>`<article class="post-row"><div class="post-main"><div class="post-meta"><span class="badge ${x.featured?'live':'draft'}">${x.featured?'FEATURED':'PROJECT'}</span></div><h3>${esc(x.title)}</h3><p>${esc(x.description||'No description yet.')}</p><a class="inline-link" href="${esc(x.github)}" target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="post-actions"><button data-pedit="${esc(x.id)}" class="ghost">Edit</button><button data-pdelete="${esc(x.id)}" class="danger ghost">Delete</button></div></article>`).join(''):'<div class="empty">No projects yet.</div>';document.querySelectorAll('[data-pedit]').forEach(b=>b.onclick=()=>editProject(b.dataset.pedit));document.querySelectorAll('[data-pdelete]').forEach(b=>b.onclick=()=>deleteProject(b.dataset.pdelete))}
function editProject(id){const x=state.projects.find(p=>p.id===id);if(!x)return;state.projectEditing=id;const f=$('#projectForm');f.title.value=x.title;f.description.value=x.description||'';f.github.value=x.github;f.featured.checked=x.featured;f.id.value=x.id;$('#projectTitle').textContent='Edit project';$('#projectBadge').textContent='EDITING';window.scrollTo({top:document.querySelector('.editor-card').offsetTop-30,behavior:'smooth'})}
async function saveProject(d){const newId=`${slugify(d.title)}.md`;const old=state.projectEditing?state.projects.find(x=>x.id===state.projectEditing):null;let targetId=old?.id||newId;if(old&&old.id!==newId){const oldFile=await gh(`/repos/${REPO}/contents/src/content/projects/${encodeURIComponent(old.id)}`);await gh(`/repos/${REPO}/contents/src/content/projects/${encodeURIComponent(old.id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Rename project: ${d.title}`,sha:oldFile.sha,branch:'main'})});targetId=newId}let sha=null;if(old&&old.id===targetId){const file=await gh(`/repos/${REPO}/contents/src/content/projects/${encodeURIComponent(targetId)}`);sha=file.sha}await commitFile(`src/content/projects/${targetId}`,projectYaml(d),`${old?'Update':'Add'} project: ${d.title}`,sha);return targetId}
async function deleteProject(id){const x=state.projects.find(p=>p.id===id);if(!x||!confirm(`Delete “${x.title}” from GitHub?`))return;try{msg($('#projectMsg'),'Deleting from GitHub…');const file=await gh(`/repos/${REPO}/contents/src/content/projects/${encodeURIComponent(id)}`);await gh(`/repos/${REPO}/contents/src/content/projects/${encodeURIComponent(id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Delete project: ${x.title}`,sha:file.sha,branch:'main'})});state.projects=state.projects.filter(p=>p.id!==id);resetProject();renderProjects();msg($('#projectMsg'),'Deleted. GitHub Actions will rebuild the site.',true)}catch(e){msg($('#projectMsg'),e.message)}}
$('#projectForm').onsubmit=async e=>{e.preventDefault();if(!state.token)return msg($('#projectMsg'),'Connect GitHub first.');const d=projectData();try{msg($('#projectMsg'),state.projectEditing?'Committing update…':'Committing project…');const id=await saveProject(d);state.projects=state.projects.filter(x=>x.id!==state.projectEditing&&x.id!==id);state.projects.unshift({id,...d});resetProject();renderProjects();msg($('#projectMsg'),'Committed to GitHub. GitHub Actions will rebuild the site shortly.',true)}catch(e){msg($('#projectMsg'),e.message)}};$('#newProject').onclick=resetProject;

$('#saveAuth').onclick=async()=>{const token=$('#token').value.trim();if(!token)return;state.token=token;try{const me=await gh('/user');sessionStorage.setItem('adrxor_github_token',token);$('#authStatus').textContent=`Connected as ${me.login} · repo: ${REPO}`;$('#authStatus').className='statusline ok';}catch(e){state.token='';sessionStorage.removeItem('adrxor_github_token');$('#authStatus').textContent='Could not connect. Check the token and repository permission.';$('#authStatus').className='statusline err'}};
$('#logout').onclick=()=>{state.token='';sessionStorage.removeItem('adrxor_github_token');$('#token').value='';$('#authStatus').textContent='Locked.';$('#authStatus').className='statusline'};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('#'+b.dataset.tab).classList.add('active')});
$('#blogForm').onsubmit=async e=>{e.preventDefault();if(!state.token)return msg($('#blogMsg'),'Connect GitHub first.');const data=formData();if(!data.title||!data.content)return;try{msg($('#blogMsg'),state.editing?'Committing update…':'Committing post…');await savePost(data);msg($('#blogMsg'),'Committed to GitHub. GitHub Actions will rebuild the site shortly.',true);const id=`${slugify(data.slug||data.title)}.md`;const old=state.editing?state.posts.find(p=>p.id===state.editing):null;const item={id,title:data.title,slug:slugify(data.slug||data.title),excerpt:data.excerpt,description:data.excerpt,tags:data.tags,content:data.content,published:data.published,date:new Date().toISOString()};state.posts=state.posts.filter(p=>p.id!==old?.id);state.posts.unshift(item);resetEditor();renderPosts()}catch(x){msg($('#blogMsg'),x.message)}};
$('#newPost').onclick=resetEditor;$('#refreshPosts').onclick=()=>location.reload();$('#postSearch').oninput=renderPosts;$('#postFilter').onchange=renderPosts;
$('#previewPost').onclick=()=>{const f=formData();const w=window.open('/blog/?preview=1','_blank');if(w)sessionStorage.setItem('adrxor_preview',JSON.stringify(f))};
if(state.token){$('#token').value='';gh('/user').then(me=>{$('#authStatus').textContent=`Connected as ${me.login} · saved session`,$('#authStatus').className='statusline ok'}).catch(()=>{state.token='';sessionStorage.removeItem('adrxor_github_token')})}
renderPosts();renderResearch();renderProjects();
</script>
<style>
