---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Podcast — Adrian"><section class="page podcast"><div class="eyebrow">/ podcast</div><div class="pod-wrap"><div><h1>AI,<br/><em>every Sunday.</em></h1><p>A weekly signal-over-noise briefing on what is actually happening in AI — new models, research, products, and ideas worth paying attention to.</p></div><div class="pod-card"><div class="circle">▶</div><strong>ADRIAN</strong><span>AI / SUNDAY</span><small>COMING SOON</small></div></div><div class="platforms"><span>SPOTIFY</span><span>YOUTUBE</span><span>APPLE PODCASTS</span><b>SOON</b></div></section></Layout>
<style>.pod-wrap{display:grid;grid-template-columns:1fr 340px;gap:90px;align-items:center;padding:75px 0 90px}.podcast h1{font-size:clamp(75px,11vw,145px);line-height:.8;letter-spacing:-.08em;margin:20px 0 35px}.podcast p{max-width:650px;font-size:19px}.pod-card{aspect-ratio:1;background:#1a1a1a;color:white;border-radius:28px;padding:28px;display:flex;flex-direction:column;position:relative;box-shadow:0 25px 60px #1717171a}.circle{width:74px;height:74px;border-radius:50%;background:var(--orange);display:grid;place-items:center;font-size:24px;color:white;margin-bottom:auto}.pod-card strong{font:700 28px var(--display)}.pod-card span{font:10px var(--mono);color:#aeb8ff}.pod-card small{position:absolute;top:28px;right:28px;font:9px var(--mono);color:#aaa}.platforms{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line)}.platforms>*{padding:20px;border-right:1px solid var(--line);font:10px var(--mono);color:#777}.platforms>*:last-child{border:0;color:var(--blue)}@media(max-width:750px){.pod-wrap{grid-template-columns:1fr;gap:40px}.pod-card{width:min(100%,340px)}.platforms{grid-template-columns:1fr 1fr}}
</style>
