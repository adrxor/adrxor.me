---
import Layout from '../layouts/Layout.astro'; import { getCollection } from 'astro:content';
const research=(await getCollection('research')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="Research — Adrian"><section class="page"><div class="eyebrow">/ research library</div><div class="research-head"><h1>Things worth<br/><em>understanding.</em></h1><div><p>A focused library of technical deep dives, papers, experiments, and ideas worth exploring beyond the surface.</p><a href="https://github.com/adrxor/research-library" target="_blank">Open library ↗</a></div></div><div class="research-list">{research.map((item,i)=><article><div class="rnum">{String(i+1).padStart(2,'0')}</div><div><small>{item.data.date.toLocaleDateString('en-US')}</small><h2>{item.data.title}</h2><p>{item.data.description}</p><div class="tags">{item.data.tags.map(t=><span>#{t}</span>)}</div></div>{item.data.pdf&&<a class="pdf" href={item.data.pdf} target="_blank">PDF ↗</a>}</article>)}</div></section></Layout>
<style>.research-head{display:grid;grid-template-columns:1fr .7fr;gap:80px;align-items:end;border-bottom:1px solid var(--line);padding-bottom:55px}.research-head h1{font-size:clamp(60px,8vw,108px);line-height:.84;letter-spacing:-.065em;margin:20px 0 0}.research-head p{font-size:16px}.research-head a{color:var(--blue);text-decoration:none;font:600 11px var(--mono)}.research-list{margin-top:28px}.research-list article{display:grid;grid-template-columns:70px 1fr auto;gap:25px;padding:28px 0;border-bottom:1px solid var(--line);align-items:start}.rnum{font:600 11px var(--mono);color:#aaa49b}.research-list small{font:10px var(--mono);color:#8c877f}.research-list h2{font-size:28px;letter-spacing:-.04em;margin:9px 0}.research-list p{margin:0;max-width:700px}.tags{display:flex;gap:7px;margin-top:15px}.tags span{font:9px var(--mono);color:var(--blue)}.pdf{font:600 10px var(--mono);color:var(--ink);text-decoration:none;border:1px solid var(--line);padding:9px 11px;border-radius:9px}.pdf:hover{background:var(--ink);color:#fff}@media(max-width:750px){.research-head{grid-template-columns:1fr;gap:20px}.research-list article{grid-template-columns:40px 1fr}.pdf{grid-column:2;justify-self:start}}
</style>
