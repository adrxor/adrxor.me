---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Research — Adrian" description="Adrian's research library: technical notes, datasets, papers, experiments, and research projects.">
<section class="page"><div class="eyebrow">/ research library</div><h1>Curiosity,<br/><em>organized.</em></h1><div class="intro"><p>A dedicated space for the things I study, investigate, test, and collect — from machine learning and data to systems, papers, datasets, and technical rabbit holes.</p><a class="github" href="https://github.com/adrxor/research-library" target="_blank" rel="noreferrer">Open Research Library on GitHub ↗</a></div><div class="cards"><article><span>01 · NOTES</span><h2>Technical Notes</h2><p>Concepts, explanations, mistakes, discoveries, and useful references collected while building.</p></article><article><span>02 · DATA</span><h2>Datasets</h2><p>Datasets and data sources I use for experiments, analysis, and machine-learning projects.</p></article><article><span>03 · PAPERS</span><h2>Research</h2><p>Papers, ideas, and research directions worth reading, understanding, and experimenting with.</p></article><article><span>04 · EXPERIMENTS</span><h2>Experiments</h2><p>Small technical investigations that don't necessarily become full projects — but are worth keeping.</p></article></div><div id="published" class="published"></div></section>
</Layout>
<script>const api='https://api.adrxor.me';const el=document.querySelector('#published');const esc=s=>String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));fetch(api+'/api/research').then(r=>r.ok?r.json():Promise.reject()).then(d=>{if(!d.items?.length)return;el.innerHTML='<div class="eyebrow">/ published research</div><div class="pubgrid">'+d.items.map(x=>`<a class="pub" href="${api+x.file_url}" target="_blank" rel="noreferrer"><small>${esc(x.created_at)}</small><h3>${esc(x.title)}</h3><p>${esc(x.description||'')}</p><span>Open PDF ↗</span></a>`).join('')+'</div>'}).catch(()=>{});</script>
<style>.page{padding:110px 0}.page>h1{font-size:clamp(58px,8vw,100px);line-height:.9;letter-spacing:-.065em;margin:20px 0 45px}.page h1 em{font-style:normal;color:var(--lime)}.intro{display:flex;justify-content:space-between;gap:50px;align-items:end;border-bottom:1px solid var(--line);padding-bottom:55px;margin-bottom:18px}.intro p{max-width:650px;color:#aeb4ad;font-size:18px;line-height:1.7;margin:0}.github{color:var(--lime);text-decoration:none;font:500 12px 'JetBrains Mono';white-space:nowrap}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.cards article{min-height:250px;border:1px solid var(--line);padding:30px;background:linear-gradient(145deg,#121613,#0d100f);transition:transform .2s,border-color .2s}.cards article:hover{transform:translateY(-4px);border-color:#414940}.cards span{font:10px 'JetBrains Mono';color:var(--lime)}.cards h2{font-size:30px;letter-spacing:-.04em;margin:48px 0 12px}.cards p{color:#959c94;line-height:1.7;max-width:500px}.published{margin-top:80px}.pubgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:18px}.pub{border:1px solid var(--line);padding:25px;text-decoration:none;color:#fff}.pub small,.pub span{font:10px 'JetBrains Mono';color:var(--lime)}.pub h3{font-size:24px;margin:35px 0 10px}.pub p{color:#8f978f;line-height:1.6}.pub:hover{border-color:#596352}@media(max-width:750px){.page{padding:80px 0}.intro{display:block}.github{display:inline-block;margin-top:28px;white-space:normal}.cards,.pubgrid{grid-template-columns:1fr}}
</style>
