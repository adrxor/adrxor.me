---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Adrian — ML/AI Engineer"><section class="home"><div class="hero-label"><span>01</span><span>ML / AI ENGINEER</span><span>2026</span></div><div class="hero"><div class="hero-copy"><h1>I turn<br/><em>ideas</em> into<br/>systems.</h1><p>I'm Adrian — an ML/AI Engineer building practical machine learning systems, experiments, and technical projects. I care about the gap between a clever idea and software that actually works.</p><div class="actions"><a class="button dark" href="/projects">Explore projects <b>↗</b></a><a class="button light" href="/about">About me</a></div></div><div class="visual"><div class="orb"><span>ML</span><small>01</small></div><div class="floating f1">DATA → MODEL</div><div class="floating f2">BUILD / MEASURE</div><div class="signature">ADRIAN<br/><span>CURIOUS BY DEFAULT.</span></div></div></div><div class="ticker"><span>Machine Learning</span><b>✦</b><span>AI Systems</span><b>✦</b><span>Data</span><b>✦</b><span>Engineering</span><b>✦</b><span>Research</span></div><section class="home-grid"><div class="manifesto"><span class="eyebrow">/ philosophy</span><h2>Less hype.<br/><em>More shipping.</em></h2></div><div class="feature"><span>FEATURED PROJECT · 01</span><h3>California House<br/>Price Prediction</h3><p>An end-to-end regression project focused on data preparation, model comparison, evaluation, and reproducible ML workflow.</p><a href="/projects">View project ↗</a></div></section></section></Layout>
<style>.home{padding-top:36px}.hero-label{display:grid;grid-template-columns:60px 1fr 60px;font:10px var(--mono);color:#8a857d;letter-spacing:.1em;border-bottom:1px solid var(--line);padding-bottom:15px}.hero-label span:last-child{text-align:right}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:610px;align-items:center;gap:60px}.hero h1{font-size:clamp(70px,9vw,132px);line-height:.8;letter-spacing:-.075em;margin:0 0 38px}.hero-copy>p{max-width:610px;font-size:18px;line-height:1.7;color:#6f6b64}.actions{display:flex;gap:10px;margin-top:32px}.button{padding:14px 18px;border-radius:12px;text-decoration:none;font-weight:600;font-size:13px}.button.dark{background:var(--ink);color:#fff}.button.dark b{margin-left:22px}.button.light{background:#fffdf8;color:var(--ink);border:1px solid var(--line)}.visual{height:500px;position:relative;border-left:1px solid var(--line);display:grid;place-items:center;background:linear-gradient(135deg,#eeebe3aa,#ffffff30);overflow:hidden}.visual:before{content:'';position:absolute;width:420px;height:420px;border:1px solid #c9c4ba;border-radius:50%;box-shadow:0 0 0 65px #3157ff0b,0 0 0 130px #3157ff06}.orb{width:250px;height:250px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#171717,#424242);color:white;box-shadow:25px 30px 70px #17171735;transform:rotate(-8deg);position:relative}.orb span{font:700 70px var(--display);letter-spacing:-.08em}.orb small{position:absolute;bottom:35px;right:42px;font:10px var(--mono);color:#c8c8c8}.floating{position:absolute;background:#fffdf8;border:1px solid var(--line);padding:11px 14px;font:10px var(--mono);box-shadow:0 12px 30px #17171712}.f1{top:90px;right:45px;transform:rotate(4deg)}.f2{bottom:90px;left:35px;transform:rotate(-4deg)}.signature{position:absolute;bottom:30px;right:35px;font:700 16px var(--mono);line-height:1.1}.signature span{font-size:8px;color:#88837b}.ticker{border-block:1px solid var(--line);padding:17px 0;display:flex;justify-content:space-around;align-items:center;color:#716c64;font:11px var(--mono);text-transform:uppercase}.ticker b{color:var(--orange)}.home-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:90px 0 30px}.manifesto{padding:25px 0}.manifesto h2{font-size:60px;line-height:.92;letter-spacing:-.06em}.feature{background:#1a1a1a;color:#fff;border-radius:22px;padding:35px;min-height:330px;box-shadow:0 25px 60px #17171712}.feature>span{font:10px var(--mono);color:#aeb8ff}.feature h3{font-size:38px;line-height:1;letter-spacing:-.045em;margin:55px 0 15px}.feature p{color:#bdbab4!important;font-size:14px;line-height:1.7}.feature a{color:#fff;text-decoration:none;font:11px var(--mono);display:inline-block;margin-top:15px}.feature a:hover{color:#aeb8ff}@media(max-width:850px){.hero{grid-template-columns:1fr;min-height:auto;padding:70px 0}.visual{height:400px;border-left:0}.home-grid{grid-template-columns:1fr}.hero h1{font-size:clamp(70px,17vw,120px)}}@media(max-width:520px){.hero-label{grid-template-columns:40px 1fr 45px}.visual{height:340px}.orb{width:190px;height:190px}.orb span{font-size:52px}.ticker{gap:15px;overflow:hidden;justify-content:flex-start;white-space:nowrap}.ticker span:nth-of-type(even){display:none}}
</style>
