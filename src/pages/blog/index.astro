---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedPosts = await Promise.all(posts.map(async (post) => ({
  post,
  rendered: await render(post),
})));
---
<Layout title="Blog — Adrian" description="Field notes from Adrian's ML/AI engineering work, experiments, and technical rabbit holes.">
<section class="page">
  <div class="eyebrow">/ field notes</div>
  <div class="hero"><div><h1>Build logs &<br/><em>thoughts.</em></h1><p>Notes from building, debugging, learning, and shipping ML/AI systems.</p></div><div class="count" id="count">{posts.length} {posts.length === 1 ? 'note' : 'notes'}</div></div>
  <div class="toolbar"><input id="search" placeholder="Search field notes…"><select id="filter"><option value="all">All notes</option><option value="ml">ML / AI</option><option value="data">Data</option><option value="systems">Systems</option></select></div>
  <div id="posts" class="posts">
    {posts.length ? posts.map((post, i) => (
      <a class="post" href={`?slug=${encodeURIComponent(post.data.slug || post.id)}`} data-slug={post.data.slug || post.id} data-search={`${post.data.title} ${post.data.excerpt} ${post.data.tags.join(' ')}`.toLowerCase()}>
        <div class="index">{String(i + 1).padStart(2, '0')}</div>
        <div class="postbody"><div class="meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US')}</time>{post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div><h2>{post.data.title}</h2><p>{post.data.excerpt || post.data.description}</p></div>
        <span class="arrow">↗</span>
      </a>
    )) : <div class="loading">No published field notes yet.</div>}
  </div>

  <div id="reader" class="reader hidden">
    <a class="back" id="back" href="/blog/">← all field notes</a>
    {renderedPosts.map(({ post, rendered }) => (
      <article class="reader-post hidden" data-reader-slug={post.data.slug || post.id}>
        <div class="reader-meta">{post.data.date.toLocaleDateString('en-US')} · {post.data.tags.map((tag) => `#${tag}`).join(' ')}</div>
        <h1>{post.data.title}</h1>
        <p class="excerpt">{post.data.excerpt || post.data.description}</p>
        <div class="content" set:html={rendered.html}></div>
      </article>
    ))}
  </div>
</section>
</Layout>
<script>
const root=document.querySelector('#posts');
const reader=document.querySelector('#reader');
const search=document.querySelector('#search');
const filter=document.querySelector('#filter');
const count=document.querySelector('#count');
const cards=[...document.querySelectorAll('.post')];
const articles=[...document.querySelectorAll('.reader-post')];

function renderList(){
  const q=search.value.toLowerCase().trim();
  const f=filter.value;
  let visible=0;
  cards.forEach(card=>{
    const hay=card.dataset.search||'';
    const matchesSearch=!q||hay.includes(q);
    const matchesFilter=f==='all'||hay.includes(f);
    const show=matchesSearch&&matchesFilter;
    card.classList.toggle('filtered-out',!show);
    if(show) visible++;
  });
  count.textContent=`${visible} ${visible===1?'note':'notes'}`;
}
function openPost(slug, push=true){
  const article=articles.find(x=>x.dataset.readerSlug===slug);
  if(!article)return false;
  root.classList.add('hidden');
  document.querySelector('.toolbar').classList.add('hidden');
  reader.classList.remove('hidden');
  articles.forEach(x=>x.classList.add('hidden'));
  article.classList.remove('hidden');
  if(push) history.pushState({slug},'',`/blog/?slug=${encodeURIComponent(slug)}`);
  window.scrollTo({top:0,behavior:'smooth'});
  return true;
}
function closePost(push=true){
  reader.classList.add('hidden');
  root.classList.remove('hidden');
  document.querySelector('.toolbar').classList.remove('hidden');
  articles.forEach(x=>x.classList.add('hidden'));
  if(push) history.pushState({},'', '/blog/');
}
search?.addEventListener('input',renderList);
filter?.addEventListener('change',renderList);
cards.forEach(card=>card.addEventListener('click',e=>{e.preventDefault();openPost(card.dataset.slug)}));
document.querySelector('#back')?.addEventListener('click',e=>{e.preventDefault();closePost()});
window.addEventListener('popstate',()=>{
  const slug=new URLSearchParams(location.search).get('slug');
  slug?openPost(slug,false):closePost(false);
});
const initial=new URLSearchParams(location.search).get('slug');
if(initial)openPost(initial,false);
</script>
<style>
.page{padding:100px 0}.hero{display:flex;justify-content:space-between;align-items:end;gap:40px;border-bottom:1px solid var(--line);padding:20px 0 55px}.hero h1{font:700 clamp(60px,8vw,108px)/.84 var(--display);letter-spacing:-.065em;margin:0 0 25px}.hero p{font-size:17px;max-width:620px}.count{font:600 10px var(--mono);color:#8a857d;white-space:nowrap}.toolbar{display:grid;grid-template-columns:1fr 160px;gap:10px;margin:24px 0}input,select{border:1px solid var(--line);background:#fffdf8;color:var(--ink);padding:14px;border-radius:10px;font:12px var(--mono)}.posts{border-top:1px solid var(--line)}.post{display:grid;grid-template-columns:65px 1fr 30px;gap:20px;align-items:start;padding:28px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);transition:.2s}.post:hover{padding-left:10px;background:#fffdf850}.index{font:10px var(--mono);color:#aaa49b}.meta{display:flex;gap:12px;font:9px var(--mono);color:#8a857d}.meta span{color:var(--blue)}.post h2{font-size:30px;line-height:1;letter-spacing:-.04em;margin:12px 0 8px}.post p{margin:0;max-width:760px;font-size:14px}.arrow{font-size:20px;color:var(--blue)}.filtered-out{display:none}.reader{max-width:850px;margin:auto;padding:30px 0 80px}.back{color:var(--blue);font:600 10px var(--mono);text-decoration:none}.reader-post{padding-top:55px}.reader-meta{font:10px var(--mono);color:#8a857d}.reader-post h1{font-size:clamp(50px,7vw,85px);line-height:.9;letter-spacing:-.06em;margin:15px 0 20px}.excerpt{font-size:19px!important}.content{font-size:17px;line-height:1.85;margin-top:50px}.content h2,.content h3{margin-top:45px}.content a{color:var(--blue)}@media(max-width:650px){.hero{display:block}.count{margin-top:20px}.toolbar{grid-template-columns:1fr}.post{grid-template-columns:35px 1fr 20px}.post h2{font-size:24px}}
</style>
