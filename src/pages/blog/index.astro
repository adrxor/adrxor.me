---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Blog — Adrian" description="Field notes from Adrian's ML/AI engineering work, experiments, and technical rabbit holes.">
<section class="page">
  <div class="eyebrow">/ field notes</div>
  <div class="hero"><div><h1>Build logs &<br/><em>thoughts.</em></h1><p>Notes from building, debugging, learning, and shipping ML/AI systems.</p></div><div class="count" id="count">— notes</div></div>
  <div class="toolbar"><input id="search" placeholder="Search field notes…"><select id="filter"><option value="all">All notes</option><option value="ml">ML / AI</option><option value="data">Data</option><option value="systems">Systems</option></select></div>
  <div id="posts" class="posts"><div class="loading">Loading field notes…</div></div>
  <article id="reader" class="reader hidden"></article>
</section>
</Layout>
<script>
const api='https://api.adrxor.me',root=document.querySelector('#posts'),reader=document.querySelector('#reader'),search=document.querySelector('#search'),filter=document.querySelector('#filter'),count=document.querySelector('#count');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let items=[];
function render(){const q=search.value.toLowerCase().trim(),f=filter.value;const out=items.filter(p=>{const hay=`${p.title} ${p.excerpt} ${(p.tags||[]).join(' ')}`.toLowerCase();return(!q||hay.includes(q))&&(f==='all'||(p.tags||[]).some(t=>t.toLowerCase().includes(f)))});count.textContent=`${out.length} ${out.length===1?'note':'notes'}`;root.innerHTML=out.length?out.map((p,i)=>`<a class="post" href="?slug=${encodeURIComponent(p.slug)}"><div class="index">${String(i+1).padStart(2,'0')}</div><div class="postbody"><div class="meta"><time>${esc(new Date(p.published_at||p.created_at).toLocaleDateString())}</time>${(p.tags||[]).slice(0,3).map(t=>`<span>#${esc(t)}</span>`).join('')}</div><h2>${esc(p.title)}</h2><p>${esc(p.excerpt||'')}</p></div><span class="arrow">↗</span></a>`).join(''):'<div class="loading">No field notes match that search.</div>'}
function openPost(slug){const p=items.find(x=>x.slug===slug);if(!p)return;root.classList.add('hidden');document.querySelector('.toolbar').classList.add('hidden');reader.classList.remove('hidden');reader.innerHTML=`<a class="back" href="/blog/">← all field notes</a><div class="reader-meta">${esc(new Date(p.published_at||p.created_at).toLocaleDateString())} · ${(p.tags||[]).map(t=>`#${esc(t)}`).join(' ')}</div><h1>${esc(p.title)}</h1><p class="excerpt">${esc(p.excerpt||'')}</p><div class="content">${renderMarkdown(p.content)}</div>`}
function renderMarkdown(s){let x=esc(s);x=x.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h2>$1</h2>').replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/^[-*] (.*)$/gm,'<li>$1</li>').replace(/(?:<li>.*<\/li>\n?)+/g,m=>`<ul>${m}</ul>`).replace(/\n\n/g,'</p><p>').replace(/\n/g,'<br>');return `<p>${x}</p>`}
fetch(api+'/api/posts').then(r=>r.ok?r.json():Promise.reject()).then(d=>{items=d.items||[];render();const slug=new URLSearchParams(location.search).get('slug');if(slug)openPost(slug)}).catch(()=>root.innerHTML='<div class="loading">Field notes are temporarily unavailable.</div>');search.oninput=render;filter.onchange=render;
</script>
<style>.page{padding:100px 0}.hero{display:flex;justify-content:space-between;align-items:end;gap:40px;border-bottom:1px solid var(--line);padding-bottom:48px}.hero h1{font-size:clamp(58px,8vw,100px);line-height:.9;letter-spacing:-.06em;margin:20px 0}.hero h1 em{font-style:normal;color:var(--lime)}.hero p{color:#929a92;line-height:1.7;max-width:560px}.count{font:11px 'JetBrains Mono';color:var(--lime);padding-bottom:8px}.toolbar{display:grid;grid-template-columns:1fr 150px;gap:8px;margin:28px 0}.toolbar input,.toolbar select{font:11px 'JetBrains Mono';background:#0f120f}.posts{border-top:1px solid var(--line);max-width:1000px}.post{display:grid;grid-template-columns:65px 1fr 35px;gap:20px;padding:28px 0;border-bottom:1px solid var(--line);text-decoration:none;color:#fff;transition:padding .2s}.post:hover{padding-left:10px;padding-right:10px;background:linear-gradient(90deg,rgba(215,255,63,.03),transparent)}.index{font:11px 'JetBrains Mono';color:#555d55}.meta{display:flex;gap:10px;flex-wrap:wrap;font:10px 'JetBrains Mono';color:#737b73}.meta span{color:var(--lime)}.post h2{font-size:27px;letter-spacing:-.04em;margin:9px 0 7px}.post p{color:#8f978f;line-height:1.6;margin:0;max-width:700px}.arrow{color:var(--lime);font-size:22px}.loading{padding:28px 0;color:#777f77;font:11px 'JetBrains Mono'}.hidden{display:none!important}.reader{max-width:820px;margin:20px auto 0}.back{display:inline-block;color:var(--lime);text-decoration:none;font:11px 'JetBrains Mono';margin-bottom:55px}.reader-meta{font:10px 'JetBrains Mono';color:#7d857d}.reader h1{font-size:clamp(45px,7vw,78px);line-height:.95;letter-spacing:-.06em;margin:18px 0}.reader .excerpt{font-size:18px;line-height:1.7;color:#9ba29b;border-bottom:1px solid var(--line);padding-bottom:30px}.content{font-size:17px;line-height:1.9;color:#d5d9d2}.content h2,.content h3{line-height:1.2;letter-spacing:-.03em;margin-top:42px}.content code{font:13px 'JetBrains Mono';color:var(--lime);background:#121612;padding:2px 5px}.content ul{padding-left:25px}@media(max-width:650px){.page{padding:70px 0}.hero{display:block}.count{margin-top:25px}.toolbar{grid-template-columns:1fr}.post{grid-template-columns:35px 1fr 20px}.post h2{font-size:22px}}
</style>
