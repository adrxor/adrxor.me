---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);

    return {
      post,
      Content,
    };
  })
);
---

<Layout
  title="Blog — Adrian"
  description="Field notes from Adrian's ML/AI engineering work, experiments, and technical rabbit holes."
>
  <section class="page">
    <div class="eyebrow">/ field notes</div>

    <div class="hero">
      <div>
        <h1>Build logs &<br /><em>thoughts.</em></h1>

        <p>
          Notes from building, debugging, learning, and shipping ML/AI systems.
        </p>
      </div>

      <div class="count" id="count">
        {posts.length} {posts.length === 1 ? 'note' : 'notes'}
      </div>
    </div>

    <div class="toolbar">
      <input
        id="search"
        type="search"
        placeholder="Search field notes…"
        autocomplete="off"
      />

      <select id="filter">
        <option value="all">All notes</option>
        <option value="ml">ML / AI</option>
        <option value="data">Data</option>
        <option value="python">Python</option>
        <option value="linux">Linux</option>
      </select>
    </div>

    <div id="posts" class="posts">
      {
        posts.length ? (
          posts.map((post, i) => {
            const slug = post.data.slug || post.id;
            const tags = post.data.tags || [];

            return (
              <a
                class="post"
                href={`/blog/?slug=${encodeURIComponent(slug)}`}
                data-slug={slug}
                data-search={`${post.data.title} ${post.data.excerpt || ''} ${post.data.description || ''} ${tags.join(' ')}`.toLowerCase()}
              >
                <div class="index">
                  {String(i + 1).padStart(2, '0')}
                </div>

                <div class="postbody">
                  <div class="meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString('en-US')}
                    </time>

                    {tags.slice(0, 3).map((tag) => (
                      <span>#{tag}</span>
                    ))}
                  </div>

                  <h2>{post.data.title}</h2>

                  {
                    (post.data.excerpt || post.data.description) && (
                      <p>
                        {post.data.excerpt || post.data.description}
                      </p>
                    )
                  }
                </div>

                <span class="arrow">↗</span>
              </a>
            );
          })
        ) : (
          <div class="loading">
            No published field notes yet.
          </div>
        )
      }
    </div>

    <div id="empty" class="loading hidden">
      No field notes match your search.
    </div>

    <div id="reader" class="reader hidden">
      <a class="back" id="back" href="/blog/">
        ← all field notes
      </a>

      {
        renderedPosts.map(({ post, Content }) => (
          <article
            class="reader-post hidden"
            data-reader-slug={post.data.slug || post.id}
          >
            <div class="reader-meta">
              {post.data.date.toLocaleDateString('en-US')}
              {' · '}
              {(post.data.tags || [])
                .map((tag) => `#${tag}`)
                .join(' ')}
            </div>

            <h1>{post.data.title}</h1>

            {
              (post.data.excerpt || post.data.description) && (
                <p class="excerpt">
                  {post.data.excerpt || post.data.description}
                </p>
              )
            }

            <div class="content">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  const root = document.querySelector('#posts');
  const reader = document.querySelector('#reader');
  const search = document.querySelector('#search');
  const filter = document.querySelector('#filter');
  const count = document.querySelector('#count');
  const empty = document.querySelector('#empty');
  const back = document.querySelector('#back');

  const cards = [...document.querySelectorAll('.post')];
  const articles = [...document.querySelectorAll('.reader-post')];

  function renderList() {
    if (!search || !filter || !count) return;

    const q = search.value.toLowerCase().trim();
    const f = filter.value.toLowerCase();

    let visible = 0;

    cards.forEach((card) => {
      const hay = (card.dataset.search || '').toLowerCase();

      const matchesSearch =
        !q || hay.includes(q);

      const matchesFilter =
        f === 'all' || hay.includes(f);

      const show =
        matchesSearch && matchesFilter;

      card.classList.toggle('filtered-out', !show);

      if (show) {
        visible++;
      }
    });

    count.textContent =
      `${visible} ${visible === 1 ? 'note' : 'notes'}`;

    empty?.classList.toggle(
      'hidden',
      visible !== 0
    );
  }

  function openPost(slug, push = true) {
    if (!root || !reader) return false;

    const article = articles.find(
      (item) => item.dataset.readerSlug === slug
    );

    if (!article) return false;

    root.classList.add('hidden');

    document.querySelector('.toolbar')?.classList.add('hidden');
    document.querySelector('.hero')?.classList.add('hidden');
    document.querySelector('.eyebrow')?.classList.add('hidden');

    empty?.classList.add('hidden');

    reader.classList.remove('hidden');

    articles.forEach((item) => {
      item.classList.add('hidden');
    });

    article.classList.remove('hidden');

    if (push) {
      history.pushState(
        { slug },
        '',
        `/blog/?slug=${encodeURIComponent(slug)}`
      );
    }

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

    return true;
  }

  function closePost(push = true) {
    if (!root || !reader) return;

    reader.classList.add('hidden');

    root.classList.remove('hidden');

    document.querySelector('.toolbar')?.classList.remove('hidden');
    document.querySelector('.hero')?.classList.remove('hidden');
    document.querySelector('.eyebrow')?.classList.remove('hidden');

    articles.forEach((item) => {
      item.classList.add('hidden');
    });

    if (push) {
      history.pushState({}, '', '/blog/');
    }

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

    renderList();
  }

  search?.addEventListener('input', renderList);
  filter?.addEventListener('change', renderList);

  cards.forEach((card) => {
    card.addEventListener('click', (event) => {
      event.preventDefault();

      const slug = card.dataset.slug;

      if (slug) {
        openPost(slug);
      }
    });
  });

  back?.addEventListener('click', (event) => {
    event.preventDefault();
    closePost();
  });

  window.addEventListener('popstate', () => {
    const slug =
      new URLSearchParams(window.location.search).get('slug');

    if (slug) {
      openPost(slug, false);
    } else {
      closePost(false);
    }
  });

  const initialSlug =
    new URLSearchParams(window.location.search).get('slug');

  if (initialSlug) {
    openPost(initialSlug, false);
  } else {
    renderList();
  }
</script>

<style>
  .page {
    padding: 100px 0;
  }

  .eyebrow {
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 20px 0 55px;
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(58px, 8vw, 108px);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero p {
    max-width: 620px;
    margin: 30px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .count {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
  }

  .toolbar {
    display: flex;
    gap: 12px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .toolbar input,
  .toolbar select {
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    padding: 0 14px;
    font: inherit;
    outline: none;
  }

  .toolbar input {
    flex: 1;
  }

  .toolbar select {
    min-width: 150px;
  }

  .toolbar input:focus,
  .toolbar select:focus {
    border-color: var(--accent);
  }

  .posts {
    display: flex;
    flex-direction: column;
  }

  .post {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition:
      padding 180ms ease,
      opacity 180ms ease;
  }

  .post:hover {
    padding-left: 10px;
    padding-right: 10px;
  }

  .post.filtered-out {
    display: none;
  }

  .index {
    color: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .postbody {
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 12px;
  }

  .meta span {
    color: var(--accent);
  }

  .post h2 {
    margin: 0;
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .post p {
    max-width: 760px;
    margin: 10px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .arrow {
    color: var(--muted);
    font-size: 22px;
    transition: transform 180ms ease;
  }

  .post:hover .arrow {
    transform: translate(4px, -4px);
    color: var(--accent);
  }

  .loading {
    padding: 50px 0;
    color: var(--muted);
  }

  .reader {
    padding-top: 20px;
  }

  .back {
    display: inline-block;
    margin-bottom: 70px;
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .reader-post {
    max-width: 900px;
    margin: 0 auto;
  }

  .reader-meta {
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .reader-post h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .excerpt {
    max-width: 760px;
    margin: 28px 0 55px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .content {
    max-width: 780px;
    font-size: 17px;
    line-height: 1.85;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin-top: 2.2em;
    margin-bottom: 0.7em;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .content :global(h2) {
    font-size: 32px;
  }

  .content :global(h3) {
    font-size: 25px;
  }

  .content :global(p) {
    margin: 0 0 1.4em;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
  }

  .content :global(li) {
    margin-bottom: 0.5em;
  }

  .content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .content :global(blockquote) {
    margin: 2em 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }

  .content :global(pre) {
    overflow-x: auto;
    margin: 2em 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-size: 14px;
    line-height: 1.6;
  }

  .content :global(code) {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
  }

  .content :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--surface);
    font-size: 0.9em;
  }

  .content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em 0;
    border-radius: 10px;
  }

  .content :global(hr) {
    margin: 3em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .content :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 2em 0;
    border-collapse: collapse;
  }

  .content :global(th),
  .content :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--line);
    text-align: left;
  }

  .content :global(th) {
    font-weight: 700;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 700px) {
    .page {
      padding: 60px 0;
    }

    .hero {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 35px;
    }

    .hero h1 {
      font-size: clamp(50px, 15vw, 80px);
    }

    .toolbar {
      flex-direction: column;
    }

    .toolbar select {
      width: 100%;
    }

    .post {
      grid-template-columns: 40px 1fr auto;
      gap: 12px;
      padding: 24px 0;
    }

    .post h2 {
      font-size: 22px;
    }

    .reader-post h1 {
      font-size: 48px;
    }

    .content {
      font-size: 16px;
    }
  }
</style>
