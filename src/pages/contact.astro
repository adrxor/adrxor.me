---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Adrian"><section class="page contact"><div class="eyebrow">/ contact</div><div class="contact-grid"><div><h1>Let's build<br/><em>something.</em></h1><p>Projects, technical conversations, collaboration, or just saying hello.</p></div><div class="contact-card"><span>GET IN TOUCH</span><a href="mailto:adrian@adrxor.me">adrian@adrxor.me <b>↗</b></a><a href="https://github.com/adrxor" target="_blank">github.com/adrxor <b>↗</b></a></div></div></section></Layout>
<style>.contact-grid{display:grid;grid-template-columns:1fr .75fr;gap:90px;align-items:end;padding:90px 0}.contact h1{font-size:clamp(75px,11vw,145px);line-height:.8;letter-spacing:-.08em;margin:20px 0 35px}.contact p{font-size:19px;max-width:560px}.contact-card{background:#1a1a1a;color:#fff;border-radius:22px;padding:30px}.contact-card>span{font:9px var(--mono);color:#aeb8ff}.contact-card a{display:flex;justify-content:space-between;color:#fff;text-decoration:none;font:500 15px var(--mono);padding:22px 0;border-bottom:1px solid #ffffff1b}.contact-card a:last-child{border:0}.contact-card b{color:#aeb8ff}@media(max-width:750px){.contact-grid{grid-template-columns:1fr;gap:30px;padding-top:55px}}
</style>
