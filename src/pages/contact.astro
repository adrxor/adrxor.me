---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Adrian"><section class="contact"><div class="eyebrow">/ contact</div><h1>Let's build<br/><em>something.</em></h1><p>For projects, technical conversations, collaboration, or just saying hello.</p><div class="links"><a href="mailto:adrian@adrxor.me"><span>EMAIL</span>adrian@adrxor.me ↗</a><a href="https://github.com/adrxor" target="_blank" rel="noreferrer"><span>GITHUB</span>github.com/adrxor ↗</a></div></section></Layout>
<style>.contact{padding:120px 0 160px;max-width:900px}.contact h1{font-size:clamp(65px,10vw,120px);line-height:.88;letter-spacing:-.07em;margin:22px 0 30px}.contact h1 em{font-style:normal;color:var(--lime)}.contact>p{color:#9da49c;font-size:18px;max-width:600px;line-height:1.7}.links{margin-top:60px;border-top:1px solid var(--line)}.links a{display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--line);color:#fff;text-decoration:none;font:500 17px 'JetBrains Mono'}.links a:hover{color:var(--lime)}.links span{font-size:10px;color:var(--muted)}
</style>
