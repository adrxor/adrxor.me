---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Adrian"><section class="page about"><div class="eyebrow">/ about</div><h1>Engineer first.<br/><em>Curious always.</em></h1><div class="about-layout"><div><p class="lead">I'm Adrian, an ML/AI Engineer focused on building practical systems with machine learning, data, and code.</p><p>I care about the whole path from an idea to something that actually works: understanding the data, choosing the right approach, writing reliable software, testing assumptions, and measuring the result.</p><p>My interests sit where machine learning, AI, systems, and developer tooling overlap. I learn by building, breaking things, and figuring out why they broke.</p></div><aside><div><small>01</small><b>Machine Learning</b><span>Models · evaluation · experiments</span></div><div><small>02</small><b>AI Systems</b><span>Useful systems around useful models</span></div><div><small>03</small><b>Engineering</b><span>Python · Linux · Git · Cloud</span></div></aside></div></section></Layout>
<style>.about h1{font-size:clamp(64px,9vw,120px);line-height:.84;margin:20px 0 80px}.about-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:100px}.about-layout>div{max-width:700px}.lead{font:500 25px/1.45 var(--display)!important;color:var(--ink)!important}.about-layout p{font-size:16px}.about aside{background:#1a1a1a;color:#fff;border-radius:20px;padding:10px 30px;align-self:start}.about aside div{padding:27px 0;border-bottom:1px solid #ffffff1c}.about aside div:last-child{border:0}.about aside small{font:9px var(--mono);color:#aeb8ff;display:block;margin-bottom:12px}.about aside b,.about aside span{display:block}.about aside b{font:600 20px var(--display);margin-bottom:5px}.about aside span{color:#aaa;font-size:12px}@media(max-width:800px){.about-layout{grid-template-columns:1fr;gap:45px}.about h1{margin-bottom:55px}}
</style>
